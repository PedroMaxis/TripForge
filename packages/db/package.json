{
  "name": "@tripforge/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "dev:postgres": "tsx src/dev-postgres.ts",
    "build": "esbuild src/migrate.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/migrate.mjs"
  },
  "dependencies": {
    "@tripforge/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "16.16.0-beta.19",
    "tsx": "^4.23.15",
    "esbuild": "^0.28.2"
  }
}
