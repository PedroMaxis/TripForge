{
  "name": "@tripforge/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "cp -r .next/static .next/standalone/apps/web/.next/ && node --env-file-if-exists=../../.env .next/standalone/apps/web/server.js",
    "typecheck": "next typegen && tsc -p .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tripforge/core": "workspace:*",
    "@tripforge/db": "workspace:*",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "next-intl": "^4.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5"
  }
}
