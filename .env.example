# Copy to .env. Generate each secret with: openssl rand -hex 32
APP_URL=http://localhost:3000
DATABASE_URL=postgres://tripforge:tripforge@localhost:5432/tripforge
BETTER_AUTH_SECRET=
REALTIME_SECRET=

# Optional. Password recovery needs an SMTP server; without it the link is hidden.
SMTP_URL=
MAIL_FROM=

# Optional. Outside services, with free public defaults (see README).
PHOTON_URL=
ROUTING_URL=
MAP_STYLE_URL=
TERRAIN_URL=
