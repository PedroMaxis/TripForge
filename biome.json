{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "infra/**",
      ".github/**",
      "*.json",
      "*.ts",
      "*.yaml",
      "!**/.next",
      "!**/.next-e2e",
      "!**/dist",
      "!**/migrations",
      "!**/test-results",
      "!**/next-env.d.ts",
      "!**/*.md",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  }
}
