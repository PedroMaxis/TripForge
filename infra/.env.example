# Production settings, read by compose.yml. Keep the real file only on the server.
# Generate secrets with: openssl rand -hex 32 (hex keeps the database URL valid).
SITE_ADDRESS=tripforge.example.com
APP_URL=https://tripforge.example.com
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
REALTIME_SECRET=

# Optional. Password recovery needs an SMTP server, e.g. smtps://user:password@smtp.example.com
SMTP_URL=
MAIL_FROM=

# Optional. Outside services, with free public defaults (see README).
PHOTON_URL=
ROUTING_URL=
MAP_STYLE_URL=
TERRAIN_URL=
